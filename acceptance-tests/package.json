{
  "name": "evcc-battery-scheduled-load-acceptance-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-as-source acceptance suite for evcc-battery-scheduled-load",
  "type": "commonjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && cucumber-js",
    "test:specs": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && cucumber-js -p specs",
    "lint:specs": "node extract-gherkin.cjs && gherkin-lint .extracted"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "cheerio": "^1.2.0",
    "gherkin-lint": "^4.2.4",
    "glob": "^14.0.4"
  }
}
